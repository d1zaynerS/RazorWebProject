@page
@model RazorWebProject.Pages.IndexModel
@{
    ViewData["Title"] = "To-Do List";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">Список завдань (To-Do List)</h2>


    <form method="post" asp-page-handler="Add" class="row g-3 mb-4">
        <div class="col-md-9">
            <input asp-for="NewTask.Title" class="form-control" placeholder="Введіть нове завдання..." required />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Додати завдання</button>
        </div>
    </form>


    <ul class="list-group">
        @foreach (var task in Model.Tasks)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span style="@(task.IsCompleted ? "text-decoration: line-through; color: gray;" : "")">
                    @task.Title
                </span>
                <div>

                    <form method="post" asp-page-handler="Toggle" asp-route-id="@task.Id" class="d-inline">
                        <button type="submit" class="btn btn-sm @(task.IsCompleted ? "btn-secondary" : "btn-success")">
                            @(task.IsCompleted ? "Невиконано" : "Виконано")
                        </button>
                    </form>


                    <form method="post" asp-page-handler="Delete" asp-route-id="@task.Id" class="d-inline ms-2">
                        <button type="submit" class="btn btn-sm btn-danger">Видалити</button>
                    </form>
                </div>
            </li>
        }
    </ul>
</div>